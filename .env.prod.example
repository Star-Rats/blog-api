# ===== prod 环境模板：复制为 .env.prod 后按实际环境修改 =====
APP_ENV=prod
DEBUG=false
HOST=0.0.0.0
PORT=8000

# 数据库
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=blog
DB_PASSWORD=change-me
DB_NAME=blog
DB_ECHO=false

# Redis 缓存（读接口 cache-aside；留空=不启用，接口自动直连数据库）
REDIS_URL=redis://redis:6379/0

# 语雀：Token 与知识库链接在管理后台配置，不在这里配置

# 管理端（务必修改默认账号密码与 JWT 密钥）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
JWT_SECRET=please-generate-a-long-random-secret

# 站点
SITE_TITLE=My Blog
SITE_DESCRIPTION=
# 前端域名，逗号分隔
CORS_ORIGINS=https://your-blog-domain.com
