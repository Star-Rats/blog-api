# Nginx 参考配置：托管两个前端 + 反代 API
#
# 使用前：
#   1. 服务器上构建/同步前端产物（两个仓库的 dist/ 目录）
#   2. 修改 server_name 与 dist 路径
#   3. 放到 /etc/nginx/conf.d/blog.conf 后 nginx -t && systemctl reload nginx
#   4. 生产建议再叠加 certbot 配置 HTTPS

server {
    listen 80;
    server_name your-domain.com;

    # ---- 博客主站（blog-index）----
    root /opt/blog/blog-index/dist;
    index index.html;

    # ---- 管理后台（blog-admin），路径 /admin ----
    location /admin/ {
        alias /opt/blog/blog-admin/dist/;
        try_files $uri $uri/ /admin/index.html;
    }

    # ---- API 反代（FastAPI）----
    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location /docs { proxy_pass http://127.0.0.1:8000; }
    location /openapi.json { proxy_pass http://127.0.0.1:8000; }

    # SPA 路由回退
    location / {
        try_files $uri $uri/ /index.html;
    }

    # 静态资源缓存（前端构建产物带 hash，可长缓存）
    location ~* \.(js|css|png|jpg|jpeg|gif|svg|ico|woff2?)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }
}
