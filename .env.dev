# ===== dev 环境（本地开发，Docker MySQL）=====
APP_ENV=dev
DEBUG=true
HOST=127.0.0.1
PORT=8000

# 数据库（本地 Docker MySQL：docker run -d --name mysql-8.0 -p 3306:3306 -e MYSQL_ROOT_PASSWORD=root mysql:8.0.30）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=blog
DB_ECHO=false

# 语雀：Token 与知识库链接在管理后台配置（登录后 PUT /api/admin/yuque/config），不在这里配置

# 管理端
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
JWT_SECRET=dev-secret-change-me-0123456789abcdef

# 站点
SITE_TITLE=My Blog
SITE_DESCRIPTION=
CORS_ORIGINS=*
